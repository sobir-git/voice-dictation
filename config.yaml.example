audio:
  sample_rate: 16000
  format: S16_LE
  channels: 1
  temp_file: /tmp/stt_recording.wav

transcription:
  model: base.en
  compute_type: int8
  language: en
  beam_size: 1
  vad_filter: true

input:
  device_path: ""
  trigger_key: KEY_F16

output:
  method: auto
  add_space: true
  type_interval: 0.0

notifications:
  enabled: true
  audio_feedback: true
  show_indicator: true

logging:
  level: INFO
  file: ~/.local/share/speech-to-text/app.log
  max_size_mb: 10
