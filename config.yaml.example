audio:
  sample_rate: 16000
  format: S16_LE
  channels: 1
  temp_file: /tmp/stt_recording.wav  # prefix; each recording gets a unique private file
  device: default
  pipewire_node: ""  # choose a microphone in Settings → Input
  preprocess: true

transcription:
  model: parakeet-unified-en-0.6b
  # Canary 180M Flash is also available for English, German, Spanish and French.
  compute_type: int8
  language: en
  beam_size: 1
  vad_filter: true

input:
  trigger_key: KEY_F16

output:
  method: auto
  add_space: true
  type_interval: 0.0

notifications:
  enabled: true
  audio_feedback: true

ui:
  cursor_indicator: false

logging:
  level: INFO
  file: ~/.local/share/speech-to-text/app.log
  max_size_mb: 10
