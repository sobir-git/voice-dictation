audio:
  sample_rate: 16000
  format: S16_LE
  channels: 1
  temp_file: /tmp/stt_recording.wav  # legacy setting; captures are retained in the data recordings directory
  device: default
  pipewire_node: ""  # choose a microphone in Settings → Input
  preprocess: true

transcription:
  model: parakeet-unified-en-0.6b
  # Canary 180M Flash is also available for English, German, Spanish and French.
  compute_type: int8
  language: en
  beam_size: 1
  vad_filter: true

# CLI benchmarks do not change settings; --apply-optimization or Settings applies your choice.
performance:
  profile: standard  # standard, vulkan (GGUF), vulkan-full (experimental full-sequence GGUF), fast (Whisper), adaptive (base.en only)
  threads: 0         # 0 keeps the engine default; no host-specific core pinning
  by_model: {}       # --apply-optimization records each model's host-specific choice here

input:
  trigger_key: KEY_F16

output:
  method: auto
  add_space: true
  type_interval: 0.0

notifications:
  enabled: true
  audio_feedback: true

ui:
  cursor_indicator: false

# Saved dictation audio kept for history retry/playback. Transcripts are always
# kept; 0 disables either limit.
recordings:
  max_age_days: 0
  max_mb: 0

logging:
  level: INFO
  file: ~/.local/share/speech-to-text/app.log
  max_size_mb: 10
