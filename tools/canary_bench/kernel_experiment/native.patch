+#if defined(__AVX2__)
+// Four independent output rows share one activation block load and conversion.
+// Arithmetic within each row retains the reference q8_0 dot-product order.
+void research_q8_dot4(int n, float * out, const void * weights, size_t stride, const void * activation) {
+    const block_q8_0 * y = (const block_q8_0 *) activation;
+    const block_q8_0 * x0 = (const block_q8_0 *) weights;
+    const block_q8_0 * x1 = (const block_q8_0 *) ((const char *)weights + stride);
+    const block_q8_0 * x2 = (const block_q8_0 *) ((const char *)weights + 2*stride);
+    const block_q8_0 * x3 = (const block_q8_0 *) ((const char *)weights + 3*stride);
+    __m256 a0 = _mm256_setzero_ps(), a1 = a0, a2 = a0, a3 = a0;
+    for (int i = 0; i < n/QK8_0; ++i) {
+        const __m256i qy = _mm256_loadu_si256((const __m256i *)y[i].qs);
+        const float dy = GGML_CPU_FP16_TO_FP32(y[i].d);
+#define RESEARCH_ROW(R) \
+        const __m256 d##R = _mm256_set1_ps(GGML_CPU_FP16_TO_FP32(x##R[i].d) * dy); \
+        const __m256i q##R = _mm256_loadu_si256((const __m256i *)x##R[i].qs); \
+        a##R = _mm256_fmadd_ps(d##R, mul_sum_i8_pairs_float(q##R, qy), a##R);
+        RESEARCH_ROW(0)
+        RESEARCH_ROW(1)
+        RESEARCH_ROW(2)
+        RESEARCH_ROW(3)
+#undef RESEARCH_ROW
+    }
+    out[0] = hsum_float_8(a0); out[1] = hsum_float_8(a1);
+    out[2] = hsum_float_8(a2); out[3] = hsum_float_8(a3);
+}
+#endif
