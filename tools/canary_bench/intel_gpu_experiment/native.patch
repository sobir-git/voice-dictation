+// Experimental exact-order layer norm + per-channel scale + bias fusion.
+// Only contiguous F32 tensors and 1-D affine weights enter this function.
+void ggml_compute_forward_norm_affine_fused(
+    const ggml_compute_params * params, ggml_tensor * norm,
+    ggml_tensor * mul, ggml_tensor * add) {
+    const ggml_tensor * src = norm->src[0];
+    const ggml_tensor * gamma = mul->src[mul->src[0] == norm ? 1 : 0];
+    const ggml_tensor * beta = add->src[add->src[0] == mul ? 1 : 0];
+    const int64_t width = src->ne[0];
+    const int64_t rows = ggml_nrows(src);
+    const float * g = (const float *) gamma->data;
+    const float * b = (const float *) beta->data;
+    float eps;
+    memcpy(&eps, norm->op_params, sizeof(float));
+    for (int64_t row = params->ith; row < rows; row += params->nth) {
+        const float * x = (const float *) src->data + row * width;
+        float * y = (float *) add->data + row * width;
+        float sum = 0;
+        ggml_vec_sum_f32(width, &sum, x);
+        const float mean = sum / width;
+        const float variance = ggml_vec_cvar_f32(width, y, x, mean);
+        const float scale = 1.0f / sqrtf(variance + eps);
+        // Preserve each original rounding step. Reuse one output row in cache.
+        ggml_vec_scale_f32(width, y, scale);
+        ggml_vec_mul_f32(width, y, y, g);
+        ggml_vec_add_f32(width, y, y, b);
+    }
+}
